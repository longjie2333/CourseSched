<view class="risk">
  <t-icon name="error-circle"/>
  <view>非学校官方平台，仅供学习使用</view>
</view>

<bottom-btns
    bind:onReportTap="navigateToReport"
    bind:onCalendarTap="navigateToSubCalendar"
/>

<login-dialog
    visible="{{ show_login_dialog }}"
    bind:close="hideLoginDialog"
    bind:onLoggingIn="onLoggingIn"
/>

<manual-update-dialog
    visible="{{ show_manual_update_dialog }}"
    bind:close="hideManualUpdateDialog"
    bind:onManualUpdate="onManualUpdate"
/>

<detail-popup
    visible="{{ show_detail_popup }}"
    content="{{ detailContent }}"
    bind:close="hideDetailPopup"
/>

<label-popup
    visible="{{ show_label_popup }}"
    labelId="{{ labelId }}"
    startingDate="{{ startingDate }}"
    bind:close="hideLabelPopup"
/>

<ad-custom unit-id="adunit-e49083141cd739f8" style="margin: 10px;margin-top: 20px;"/>

<t-message id="t-message" />
