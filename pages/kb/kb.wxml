<navbar
    title="{{ className }}"
    currentWeeks="{{ currentWeeksIndex + 1 }}"
    showVacationTag="{{ isVacation }}"
    ifWeeksChanging="{{ ifWeeksChanging }}"
    bind:onTitleTap="displayLoginDialog"
    bind:onManualUpdateTap="displayManualUpdateDialog"
    bind:onWeeksChange="onWeeksChange"
    bind:onRollbackTap="onRollback"
/>

<t-tabs
    id="weekTabs"
    theme="tag"
    defaultValue="0"
    value="{{ currentWeeksIndex }}"
    style="{{ navbarStyle }}--td-tab-item-height: 96rpx;--week-row-height: 100rpx;--week-row-padding-top: 2px;"
    spaceEvenly="{{ false }}"
    showTabsTag="{{ show_tabs_tag }}"
    animation="{{ { duration: 0.45 } }}"
    bind:change="onTabsChangeOrSliding"
>
    <view
        slot="middle"
        class="weekRow"
    >
        <view class="">
            <view class="weekRowText"></view>
            <view class="weekRowDate"></view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][0] ? 'today' : '' }}">
            <view class="weekRowText">一</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][0] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][1] ? 'today' : '' }}">
            <view class="weekRowText">二</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][1] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][2] ? 'today' : '' }}">
            <view class="weekRowText">三</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][2] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][3] ? 'today' : '' }}">
            <view class="weekRowText">四</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][3] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][4] ? 'today' : '' }}">
            <view class="weekRowText">五</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][4] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][5] ? 'today' : '' }}">
            <view class="weekRowText">六</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][5] }}</view>
        </view>
        <view class="{{ ifToday === courseList[currentWeeksIndex][0][6] ? 'today' : '' }}">
            <view class="weekRowText">日</view>
            <view class="weekRowDate">{{ courseList[currentWeeksIndex][0][6] }}</view>
        </view>
    </view>

    <notice slot="scroll-top" />

    <t-tab-panel
        value="{{ 0 }}"
        label="第1周"
    >
        <course-grid
            weekData="{{ courseList ? courseList[0] : [] }}"
            labelData="{{ currentLabelData }}"
            bind:onCourseTap="displaySomeDetail"
            bind:labeling="displayLabelPopup"
        />
    </t-tab-panel>

