{
  "name": "course-sched-weapp-vite",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "CourseSched 微信小程序的 weapp-vite 工程",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "wv dev",
    "dev:open": "wv dev -o",
    "dev:ui": "wv dev --ui",
    "dev:open:ui": "wv dev --ui -o",
    "build": "wv build && node scripts/validate-build.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:project": "node scripts/validate-project.mjs",
    "typecheck": "vue-tsc -b --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "lint:fix": "eslint . --fix",
    "open": "wv open",
    "g": "wv generate",
    "postinstall": "wv prepare",
    "check": "pnpm validate:project && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "tdesign-miniprogram": "1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@weapp-vite/dashboard": "^6.18.6",
    "eslint": "^10.7.0",
    "globals": "^17.8.0",
    "miniprogram-api-typings": "^5.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "weapp-vite": "^6.18.6",
    "wevu": "^6.18.6"
  }
}
